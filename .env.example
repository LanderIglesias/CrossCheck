# Postgres (local Docker, see docker-compose.yml)
POSTGRES_DB=crosscheck
POSTGRES_USER=crosscheck
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://crosscheck:changeme@localhost:5432/crosscheck

# SEC EDGAR requires a descriptive User-Agent with a real contact email.
# Format: "<app/company name> <contact email>" — see https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="CrossCheck Portfolio Project you@example.com"

# Local paths
DATA_DIR=./data

# Optional — only needed for Phase 2 audio diarization (pyannote.audio). Create a free account at
# huggingface.co, accept the gated model terms for ALL THREE of:
#   - pyannote/speaker-diarization-3.1
#   - pyannote/segmentation-3.0
#   - pyannote/speaker-diarization-community-1 (pulled in internally by pyannote.audio v4's
#     implementation of the 3.1 pipeline — easy to miss, not implied by the pipeline's own name)
# then generate a read-access token under Settings > Access Tokens.
# HF_TOKEN=hf_...
#
# Diarization also requires a "full-shared" FFmpeg build on PATH (the DLLs, not just ffmpeg.exe) —
# pyannote.audio v4 decodes audio via torchcodec, which dynamically links against libavutil/
# libavcodec/etc. A static single-exe FFmpeg build (e.g. the gyan.dev "essentials" build) will NOT
# work here even though `ffmpeg -version` succeeds — get a shared build, e.g.
# https://github.com/BtbN/FFmpeg-Builds (the "...-shared.zip" asset), and put its bin/ on PATH.

# Optional — only needed for Phase 5's LLM-as-judge consistency checker
# (scripts/eval_llm_judge.py). Unlike every other model in this project (local/free), this makes
# real, paid Anthropic API calls (Claude Sonnet 5) — get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
